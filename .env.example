# ==========================================
# NoCap 遊戲環境變數設定範本
# ==========================================

# 伺服器通訊埠（雲端平台如 Zeabur、Render、Railway 通常會自動注入此變數）
PORT=3001

# 公開網址（當你綁定自訂網域時使用，例如 toldyounocap.com 或 toldyounocap.zeabur.app）
# VITE_PUBLIC_ORIGIN=https://toldyounocap.zeabur.app

# Google Gemini API 金鑰（用於題庫管理中心的 AI 自動批次產題）
# 金鑰只放在本機 .env 或部署平台的 Secret，不會交給瀏覽器。
# GEMINI_API_KEY=your_gemini_api_key_here

# 題庫管理中心密碼（必填；前端只會暫存在目前分頁的 sessionStorage）
ADMIN_PASSWORD=replace_with_a_long_random_password

# 預設禁止管理 API 改寫 JSON。本機需要使用管理頁新增/編輯時才暫時開啟。
ALLOW_DECK_WRITES=false

# 正式網址；前後端同源時可不填。多個來源用逗號分隔，正式環境不要使用 *。
# CLIENT_ORIGIN=https://your-game.onrender.com
